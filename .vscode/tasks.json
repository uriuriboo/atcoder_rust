		{
			"label": "build",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/build.py",
				"${file}"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
		},
		{
			"label": "build & test",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/test.py",
				"${file}"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
		},
		{
			"label": "build & test release",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/test_release.py",
				"${file}"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
		},
		{
			"label": "submit",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/sub.py",
				"${file}"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
		},
		{
			"label": "stress: init",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/stress.py",
				"init",
				"${file}"
			],
			"problemMatcher": [],
		},
		{
			"label": "stress: hack",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/stress.py",
				"hack",
				"${file}"
			],
			"problemMatcher": [],
		},
		{
			"label": "stress: test",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/stress.py",
				"test",
				"${file}"
			],
			"problemMatcher": [],
		},
		{
			"label": "visualize graph",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/visualize.py",
				"${workspaceFolder}/input.txt"
			],
			"problemMatcher": [],
		},
		{
			"label": "visualize graph (directed)",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/visualize.py",
				"${workspaceFolder}/input.txt",
				"--directed"
			],
			"problemMatcher": [],
		},
		// "new contest" の中の手順。単体では実行しないので、一覧（Task Explorer・Run Task）に出さない
		{
			"label": "rust: cargo compete new",
			"hide": true,
			"type": "cargo",
			"command": "compete",
			"args": [
				"new",
				"${input:contest}"
			]
		},
		{
			// cargo-compete は edition 2024 を生成できないため、AtCoder に合わせて書き換える
			"label": "rust: set edition 2024",
			"hide": true,
			"type": "shell",
			"command": "sed",
			"args": [
				"-i",
				"s/^edition = \"2021\"$/edition = \"2024\"/",
				"${input:contest}/Cargo.toml"
			]
		},
		{
			"label": "rust: cargo member include",
			"hide": true,
			"type": "cargo",
			"command": "member",
			"args": [
				"include",
				"${input:contest}"
			]
		},
		{
			"label": "new contest",
			"dependsOrder": "sequence",
			"dependsOn": [
				"rust: cargo compete new",
				"rust: set edition 2024",
				"rust: cargo member include",
			],
			"presentation": {
				"echo": false,
				"reveal": "silent",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "login",
			"type": "shell",
			"command": "cargo compete",
			"args": [
				"login",
				"atcoder",
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
		},
	],
	"inputs": [
		{
			"id": "contest",
			"description": "contestID",
			"type": "promptString"
		}
	]
}