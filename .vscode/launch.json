{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug",
            "sourceLanguages": [
                "rust"
            ],
            //"preLaunchTask": "cargo build",
            "internalConsoleOptions": "openOnSessionStart",
            "program": "/workspaces/atcoder_rust/target/debug/abc321-c",
            "args": [],
            "stdio": [
                "/workspaces/atcoder_rust/input.txt"
            ],
        },
        // 開いている Python（gen.py・naive.py）を、input.txt を標準入力にしてデバッグする
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Debug Python",
            "program": "/workspaces/atcoder_rust/scripts/debug_python.py",
            "args": [
                "${file}"
            ],
            "console": "integratedTerminal",
        }
    ]
}
