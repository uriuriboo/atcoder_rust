// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust
{
	"name": "atcoder-rust",
	// cargo-compete などのビルドをイメージのレイヤーにキャッシュするため Dockerfile を使う
	"build": {
		"dockerfile": "Dockerfile"
	},
	// Windows ホストの bind mount はファイル I/O が遅いため、ビルド成果物は名前付きボリュームに置く
	"mounts": [
		"source=atcoder-rust-target,target=/workspaces/atcoder_rust/target,type=volume"
	],

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "git checkout . && chmod a+x ./.devcontainer/postCreateCommand.bash && bash ./.devcontainer/postCreateCommand.bash",
	// Configure tool-specific properties.
	// "customizations": {},
	// "postStartCommand": "./.devcontainer/postCreateCommand.bash",
	"customizations": {
		"vscode": {
			"extensions": [
				// "rust-lang.rust",
				"EditorConfig.EditorConfig",
				"spmeesseman.vscode-taskexplorer",
				"tamasfe.even-better-toml",
				// Python（ランダムテストの gen.py・naive.py）。補完の Pylance とデバッガの debugpy も一緒に入る
				"ms-python.python",
				// Python のチェックと自動フォーマット
				"charliermarsh.ruff",
				"ms-vscode.cpptools",
				"lorenzopirro.rust-flash-snippets",
				"dustypomerleau.rust-syntax"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
