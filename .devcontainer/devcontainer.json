// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust
{
	"name": "atcoder-rust",
	"image": "mcr.microsoft.com/devcontainers/rust:1-trixie",
	// "build": {
	// 	"dockerfile": "Dockerfile"
	// },

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "git checkout . && chmod a+x ./.devcontainer/postCreateCommand.bash && bash ./.devcontainer/postCreateCommand.bash",
	// Configure tool-specific properties.
	// "customizations": {},
	// "postStartCommand": "./.devcontainer/postCreateCommand.bash",
	"customizations": {
		"vscode": {
			"extensions": [
				// "rust-lang.rust",
				"EditorConfig.EditorConfig",
				"SanaAjani.taskrunnercode",
				"tamasfe.even-better-toml",
				"ms-python.python",
				"ms-vscode.cpptools",
				"lorenzopirro.rust-flash-snippets",
				"dustypomerleau.rust-syntax"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
